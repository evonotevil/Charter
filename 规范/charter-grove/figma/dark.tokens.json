{
  "color": {
    "$type": "color",
    "canvas": {
      "$type": "color",
      "$value": "#111813",
      "$description": "窗口画布、页面底色。"
    },
    "surface": {
      "$type": "color",
      "$value": "#18211B",
      "$description": "卡片、侧栏、顶栏、表格。"
    },
    "surface-sunken": {
      "$type": "color",
      "$value": "#1F2A22",
      "$description": "表头、组织切换器、图标底、卡片内分组。"
    },
    "surface-hover": {
      "$type": "color",
      "$value": "#1C281F",
      "$description": "表格行悬停和选中。"
    },
    "line": {
      "$type": "color",
      "$value": "#2C3A30",
      "$description": "卡片 2px 描边、分隔线、次按钮描边与底边。只做分隔，不承担含义。"
    },
    "line-strong": {
      "$type": "color",
      "$value": "#66776A",
      "$description": "输入框描边、单选框、开关关闭态（≥3:1）。"
    },
    "ink": {
      "$type": "color",
      "$value": "#E9F1E6",
      "$description": "标题和正文，用在所有面上。"
    },
    "muted": {
      "$type": "color",
      "$value": "#A0AEA4",
      "$description": "说明文字、标签、元信息，用在所有面上（≥4.5:1）。原稿 #738078 只有 3.9:1，已加深。"
    },
    "faint": {
      "$type": "color",
      "$value": "#5B675E",
      "$description": "只用于占位符和禁用文字。"
    },
    "green": {
      "$type": "color",
      "$value": "#58CC02",
      "$description": "品牌绿：主按钮、徽标、选中标签下划线、进度段、开关打开。不用作文字色。"
    },
    "green-edge": {
      "$type": "color",
      "$value": "#2C7300",
      "$description": "主按钮和徽标底部的立体边。"
    },
    "on-green": {
      "$type": "color",
      "$value": "#15290A",
      "$description": "主按钮上的文字和图标。原稿用白字只有 2.09:1，改为深绿字（6.2:1）。"
    },
    "green-text": {
      "$type": "color",
      "$value": "#8FDD4E",
      "$description": "绿色文字：选中导航、链接、正常状态、日期强调。"
    },
    "green-soft": {
      "$type": "color",
      "$value": "#1C3215",
      "$description": "选中导航底、正常状态胶囊底、好消息横幅底。"
    },
    "green-soft-line": {
      "$type": "color",
      "$value": "#2E5320",
      "$description": "green-soft 上的 2px 描边。"
    },
    "green-deep": {
      "$type": "color",
      "$value": "#BDE6A0",
      "$description": "好消息横幅里的正文。"
    },
    "amber": {
      "$type": "color",
      "$value": "#D9B54A",
      "$description": "进度段里“需要处理”的一段。"
    },
    "amber-text": {
      "$type": "color",
      "$value": "#F2C76B",
      "$description": "需要处理：快到期、待核实、冲突。"
    },
    "amber-soft": {
      "$type": "color",
      "$value": "#372B10",
      "$description": "需要处理的胶囊底、“下一件事”卡片底。"
    },
    "amber-line": {
      "$type": "color",
      "$value": "#5C4A1C",
      "$description": "amber-soft 卡片的 2px 描边。"
    },
    "red": {
      "$type": "color",
      "$value": "#FF6B60",
      "$description": "进度段里“逾期”的一段、危险按钮底。"
    },
    "red-edge": {
      "$type": "color",
      "$value": "#B82A2A",
      "$description": "危险按钮的立体边。"
    },
    "red-text": {
      "$type": "color",
      "$value": "#FF9C92",
      "$description": "逾期、已过期、错误说明。"
    },
    "red-soft": {
      "$type": "color",
      "$value": "#3D1A17",
      "$description": "逾期胶囊底、错误提示底。"
    },
    "blue-text": {
      "$type": "color",
      "$value": "#A8C4F2",
      "$description": "提示性信息：本机、离线说明、识别来源。"
    },
    "blue-soft": {
      "$type": "color",
      "$value": "#1B2840",
      "$description": "提示卡片底、本机标签底。"
    },
    "purple-text": {
      "$type": "color",
      "$value": "#CDB8F0",
      "$description": "个人股东、自然人头像文字。"
    },
    "purple-soft": {
      "$type": "color",
      "$value": "#2A2140",
      "$description": "自然人头像底、个人标签底。"
    }
  },
