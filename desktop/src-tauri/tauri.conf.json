{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Charter",
  "version": "5.4.0",
  "identifier": "app.charter.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Charter",
        "width": 1440,
        "height": 920,
        "minWidth": 1080,
        "minHeight": 720,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app", "deb"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "../src/assets/charter-templates.json": "charter-templates.json" },
    "category": "Business",
    "shortDescription": "海外子公司档案管理",
    "windows": { "nsis": { "languages": ["SimpChinese", "English"], "installMode": "currentUser" } },
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
